{
  "name": "DailySalesRecord",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Linked Product ID"
    },
    "product_name": {
      "type": "string",
      "description": "Product name for display"
    },
    "quantity_lbs": {
      "type": "number",
      "description": "Quantity sold in lbs"
    },
    "sales_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the sale"
    },
    "customer_allocations": {
      "type": "array",
      "description": "How this day's sales split across customers",
      "items": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "customer_name": {
            "type": "string"
          },
          "cases": {
            "type": "number"
          },
          "lbs": {
            "type": "number"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "product_name",
    "quantity_lbs",
    "sales_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}