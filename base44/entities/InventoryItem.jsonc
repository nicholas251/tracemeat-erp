{
  "name": "InventoryItem",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Linked product ID"
    },
    "product_name": {
      "type": "string",
      "description": "Product name for display"
    },
    "sku": {
      "type": "string",
      "description": "Product SKU"
    },
    "batch_id": {
      "type": "string",
      "description": "Source batch ID"
    },
    "batch_number": {
      "type": "string",
      "description": "Source batch number"
    },
    "source_stage_id": {
      "type": "string",
      "description": "Packaging ProductionStage ID that produced this lot (recall traceability)"
    },
    "cook_batch_lot": {
      "type": "string",
      "description": "Cook batch lot this finished-goods lot came from"
    },
    "component_lots": {
      "type": "array",
      "description": "Upstream lots physically inside this FG lot: the cook batch plus any carry-over lots packed into it",
      "items": {
        "type": "object",
        "properties": {
          "lot_number": {
            "type": "string"
          },
          "lbs": {
            "type": "number"
          },
          "source": {
            "type": "string",
            "description": "cook_batch | carry_over"
          }
        }
      }
    },
    "quantity_lbs": {
      "type": "number",
      "description": "Current quantity on hand in lbs"
    },
    "original_quantity_lbs": {
      "type": "number",
      "description": "Original quantity when received into inventory in lbs"
    },
    "location": {
      "type": "string",
      "description": "Storage location (e.g. Cooler A, Freezer 2)"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "reserved",
        "shipped",
        "quarantined",
        "expired",
        "damaged"
      ],
      "default": "available",
      "description": "Current inventory status"
    },
    "production_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "storage_temp_c": {
      "type": "number",
      "description": "Required storage temperature"
    },
    "lot_number": {
      "type": "string",
      "description": "Finished goods lot number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "product_name",
    "batch_id",
    "batch_number"
  ]
}