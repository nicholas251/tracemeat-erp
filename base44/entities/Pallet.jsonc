{
  "name": "Pallet",
  "type": "object",
  "properties": {
    "pallet_number": {
      "type": "string",
      "description": "Pallet identifier"
    },
    "building_id": {
      "type": "string",
      "description": "WarehouseBuilding the pallet sits in"
    },
    "building_name": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "Spot code within the building, e.g. A1, B12"
    },
    "status": {
      "type": "string",
      "enum": [
        "stored",
        "removed"
      ],
      "default": "stored",
      "description": "stored = sitting in its spot; removed = shipped/emptied"
    },
    "lots": {
      "type": "array",
      "description": "Finished-goods lots on this pallet (multi-lot pallets supported)",
      "items": {
        "type": "object",
        "properties": {
          "inventory_item_id": {
            "type": "string"
          },
          "lot_number": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "cases": {
            "type": "number"
          },
          "lbs": {
            "type": "number"
          },
          "expiry_date": {
            "type": "string"
          }
        }
      }
    },
    "stored_at": {
      "type": "string",
      "format": "date-time"
    },
    "removed_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "location"
  ]
}